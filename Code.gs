/**
 * Chonburi Physio Booking API — Google Apps Script prototype.
 * Bind to the target spreadsheet. Configure INITIAL_ADMIN_EMAIL and
 * INITIAL_ADMIN_PASSWORD in Script Properties, run setupSheets(), then
 * run createInitialAdmin() manually from the editor. Never publish the sheet.
 * This is a prototype; Apps Script is not approved here for real medical data.
 */
const CFG={TZ:'Asia/Bangkok',SESSION_SECONDS:21600,MAX_ATTEMPTS:8,WINDOW_SECONDS:300};
const SCHEMA={
  Appointments:['id','createdAt','name','nationalId','age','phone','address','symptoms','service','date','time','therapist','status','changeCount','treatmentNote','pinSalt','pinHash'],
  Users:['email','displayName','role','active','passwordSalt','passwordHash'],
  Availability:['id','therapist','service','date','startTime','endTime','capacity','bookedCount','active'],
  Notifications:['id','appointmentId','kind','channel','recipient','scheduledAt','status','attempts','lastResult'],
  AuditLog:['timestamp','actor','role','action','recordId','detail']
};
function setupSheets(){const ss=SpreadsheetApp.openById('1XsudYWjEgZ-QKmxpBixFwC1aKsETImlIyi5JhOodEtY');Object.keys(SCHEMA).forEach(n=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);migrateHeader_(s,SCHEMA[n]);s.setFrozenRows(1)});PropertiesService.getScriptProperties().setProperty('DB_ID',ss.getId());return 'Schema ready; existing columns/data preserved.'}
function migrateHeader_(sh,expected){if(sh.getLastRow()===0){sh.getRange(1,1,1,expected.length).setValues([expected]);return}const width=Math.max(sh.getLastColumn(),1),old=sh.getRange(1,1,1,width).getDisplayValues()[0].filter(String);if(!old.length){sh.getRange(1,1,1,expected.length).setValues([expected]);return}expected.forEach(h=>{if(!old.includes(h)){sh.getRange(1,sh.getLastColumn()+1).setValue(h);old.push(h)}})}
function createInitialAdmin(){const p=PropertiesService.getScriptProperties(),email=String(p.getProperty('INITIAL_ADMIN_EMAIL')||'').trim().toLowerCase(),pw=p.getProperty('INITIAL_ADMIN_PASSWORD')||'';if(!email||pw.length<14)throw Error('Set INITIAL_ADMIN_EMAIL and a password of at least 14 characters in Script Properties first.');const s=db_().getSheetByName('Users'),rows=records_('Users');if(rows.some(x=>String(x.email).toLowerCase()===email))throw Error('Admin email already exists.');const salt=random_(),hash=hash_(pw,salt);s.appendRow([email,email,'SUPER_ADMIN',true,salt,hash]);p.deleteProperty('INITIAL_ADMIN_PASSWORD');audit_(email,'SUPER_ADMIN','CREATE_INITIAL_ADMIN',email,'Created from editor');return 'Initial Super Admin created; password property removed.'}
function doGet(e){try{const a=String(e.parameter.action||'');if(a==='health')return out_({ok:true,service:'physio-booking'});if(a==='publicSlots')return out_(publicSlots_(e.parameter.date,e.parameter.service));throw Error('Use POST for this action.')}catch(x){return out_({ok:false,error:String(x.message||x)})}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(10000);const b=JSON.parse(e.postData.contents||'{}');const a=String(b.action||'');if(a==='login')rateLimit_('login',String(b.email||'').toLowerCase());else if(['lookup','reschedule','cancel'].includes(a))rateLimit_('public',String(b.nationalId||b.id||''));else rateLimit_('write');let r;
  if(a==='login')r=login_(b);else if(a==='logout')r=logout_(b);else if(a==='book')r=book_(b);else if(a==='lookup')r=lookup_(b);else if(a==='reschedule')r=change_(b,false);else if(a==='cancel')r=change_(b,true);else if(a==='staffAppointments')r=staffAppointments_(b);else if(a==='note')r=note_(b);else if(a==='setRole')r=setRole_(b);else if(a==='setAvailability')r=setAvailability_(b);else throw Error('Unknown action');return out_({ok:true,...r})
 }catch(x){return out_({ok:false,error:String(x.message||x)})}finally{try{lock.releaseLock()}catch(_){}}}
function login_(b){const email=String(b.email||'').trim().toLowerCase(),u=records_('Users').find(x=>String(x.email).toLowerCase()===email&&truth_(x.active));if(!u||!u.passwordSalt||!constantEqual_(hash_(String(b.password||''),String(u.passwordSalt)),String(u.passwordHash||''))){audit_(email||'unknown','NONE','LOGIN_FAILED','','Invalid credentials');throw Error('อีเมลหรือรหัสผ่านไม่ถูกต้อง')}const token=random_()+random_(),sess={email,role:u.role};CacheService.getScriptCache().put('session:'+token,JSON.stringify(sess),CFG.SESSION_SECONDS);audit_(email,u.role,'LOGIN','','Success');return {token,role:u.role,name:u.displayName}}
function logout_(b){if(b.token)CacheService.getScriptCache().remove('session:'+String(b.token));return {loggedOut:true}}
function requireUser_(token,roles){const raw=CacheService.getScriptCache().get('session:'+String(token||''));if(!raw)throw Error('เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่');const s=JSON.parse(raw),u=records_('Users').find(x=>String(x.email).toLowerCase()===s.email&&truth_(x.active)&&x.role===s.role);if(!u||!roles.includes(u.role))throw Error('ไม่มีสิทธิ์');return s}
function book_(b){['name','nationalId','phone','address','symptoms','service','date','time'].forEach(k=>{if(!String(b[k]||'').trim())throw Error('กรุณากรอกข้อมูลให้ครบ')});if(!/^\d{13}$/.test(String(b.nationalId)))throw Error('เลขบัตรประชาชนต้องมี 13 หลัก');if(!/^\d{4}-\d{2}-\d{2}$/.test(String(b.date))||!/^\d{2}:\d{2}$/.test(String(b.time)))throw Error('วันหรือเวลาไม่ถูกต้อง');const dup=records_('Appointments').some(x=>x.date===b.date&&x.time===b.time&&x.service===b.service&&x.status==='CONFIRMED');if(dup)throw Error('คิวนี้ถูกจองแล้ว');const id='APT-'+Utilities.getUuid().replace(/-/g,'').slice(0,20).toUpperCase(),pin=String(Math.floor(100000+Math.random()*900000)),salt=random_();append_('Appointments',[id,new Date(),clean_(b.name,120),String(b.nationalId),Number(b.age)||'',clean_(b.phone,20),clean_(b.address,300),clean_(b.symptoms,1000),clean_(b.service,20),b.date,b.time,clean_(b.therapist||'ทีมกายภาพบำบัด',120),'CONFIRMED',0,'',salt,hash_(pin,salt)]);append_('Notifications',[random_(),' '+id,'CONFIRMATION','SIMULATED',clean_(b.phone,20),new Date(),'QUEUED',0,'Provider not configured']);audit_('PUBLIC','PUBLIC','BOOK',id,'Appointment created');return {appointment:{id,pin,date:b.date,time:b.time,service:b.service,status:'CONFIRMED'}}}
function lookup_(b){const nationalId=String(b.nationalId||'').trim(),phone=digits_(b.phone);if(!/^\d{13}$/.test(nationalId)||phone.length<9)throw Error('กรุณาตรวจสอบเลขบัตรประชาชนและเบอร์โทรศัพท์');const list=records_('Appointments').filter(a=>String(a.nationalId).trim()===nationalId&&digits_(a.phone)===phone&&a.status==='CONFIRMED').map(publicAppt_);if(!list.length)throw Error('ไม่พบรายการนัด กรุณาตรวจสอบข้อมูล หรือติดต่อศูนย์บริการ');return {appointments:list}}
function change_(b,cancel){const nationalId=String(b.nationalId||'').trim(),phone=digits_(b.phone),id=String(b.id||'').trim().toUpperCase();let a;if(nationalId&&phone){a=records_('Appointments').find(x=>x.id===id&&String(x.nationalId).trim()===nationalId&&digits_(x.phone)===phone)}else{const old=records_('Appointments').find(x=>x.id===id);if(old&&constantEqual_(hash_(String(b.pin||''),String(old.pinSalt)),String(old.pinHash||'')))a=old}if(!a)throw Error('ยืนยันข้อมูลไม่สำเร็จ กรุณาตรวจเลขบัตรประชาชนและเบอร์โทรศัพท์');if(a.status!=='CONFIRMED'||Number(a.changeCount)>=1)throw Error('รายการนี้ใช้สิทธิ์จัดการนัดแล้วหรือไม่อยู่ในสถานะยืนยัน');if(cancel)a.status='CANCELLED';else{if(!/^\d{4}-\d{2}-\d{2}$/.test(String(b.date))||!/^\d{2}:\d{2}$/.test(String(b.time)))throw Error('วันหรือเวลาไม่ถูกต้อง');if(records_('Appointments').some(x=>x.id!==a.id&&x.date===b.date&&x.time===b.time&&x.service===a.service&&x.status==='CONFIRMED'))throw Error('คิวนี้ถูกจองแล้ว');a.date=b.date;a.time=b.time}a.changeCount=Number(a.changeCount)+1;write_('Appointments',a._row,a);audit_('PUBLIC','PUBLIC',cancel?'CANCEL':'RESCHEDULE',a.id,'Self service');return {appointment:publicAppt_(a)}}
function staffAppointments_(b){const u=requireUser_(b.token,['STAFF','SUPER_ADMIN']);const list=records_('Appointments').filter(a=>u.role==='SUPER_ADMIN'||String(a.therapist).toLowerCase()===u.email).map(a=>({id:a.id,name:a.name,age:a.age,phone:a.phone,service:a.service,date:a.date,time:a.time,therapist:a.therapist,status:a.status,changeCount:a.changeCount,treatmentNote:a.treatmentNote}));return {appointments:list}}
function note_(b){const u=requireUser_(b.token,['STAFF','SUPER_ADMIN']),a=records_('Appointments').find(x=>x.id===String(b.id));if(!a)throw Error('ไม่พบนัด');if(u.role!=='SUPER_ADMIN'&&String(a.therapist).toLowerCase()!==u.email)throw Error('ไม่มีสิทธิ์ดูแลเคสนี้');a.treatmentNote=clean_(b.note,3000);write_('Appointments',a._row,a);audit_(u.email,u.role,'TREATMENT_NOTE',a.id,'Updated');return {saved:true}}
function setRole_(b){const u=requireUser_(b.token,['SUPER_ADMIN']),email=String(b.email||'').trim().toLowerCase(),role=String(b.role||'');if(!/^\S+@\S+\.\S+$/.test(email)||!['STAFF','SUPER_ADMIN'].includes(role))throw Error('ข้อมูลบัญชีไม่ถูกต้อง');const rows=records_('Users'),old=rows.find(x=>String(x.email).toLowerCase()===email);if(old){old.role=role;old.active=true;write_('Users',old._row,old)}else append_('Users',[email,clean_(b.displayName||email,100),role,true,'','']);audit_(u.email,u.role,'SET_ROLE',email,role);return {saved:true}}
function setAvailability_(b){const u=requireUser_(b.token,['SUPER_ADMIN']);if(!b.date||!b.startTime||!b.endTime||!b.therapist)throw Error('กรอกข้อมูลช่วงเวลาให้ครบ');const id='SLOT-'+Utilities.getUuid().slice(0,12);append_('Availability',[id,clean_(b.therapist,120),clean_(b.service,20),b.date,b.startTime,b.endTime,Math.max(1,Number(b.capacity)||1),0,true]);audit_(u.email,u.role,'SET_SLOT',id,b.date);return {id}}
function publicSlots_(date,service){return {slots:records_('Availability').filter(x=>x.date===date&&x.service===service&&truth_(x.active)&&Number(x.bookedCount)<Number(x.capacity)).map(x=>({id:x.id,therapist:x.therapist,date:x.date,startTime:x.startTime,endTime:x.endTime,capacity:x.capacity}))}}
function rateLimit_(action,identifier){const c=CacheService.getScriptCache(),scope=identifier?hash_(identifier,'rate-limit').slice(0,24):'all',key='rl:'+action+':'+scope,now=Date.now(),v=JSON.parse(c.get(key)||'{"n":0,"t":0}');if(now-v.t>CFG.WINDOW_SECONDS*1000){v.n=0;v.t=now}v.n++;c.put(key,JSON.stringify(v),CFG.WINDOW_SECONDS);if(v.n>CFG.MAX_ATTEMPTS&&(action==='login'||action==='public'))throw Error('ลองตรวจสอบหลายครั้งเกินไป กรุณารอ 5 นาทีแล้วลองใหม่')}
function db_(){const id=PropertiesService.getScriptProperties().getProperty('DB_ID');return id?SpreadsheetApp.openById(id):SpreadsheetApp.getActive()}
function records_(name){const sh=db_().getSheetByName(name);if(!sh||sh.getLastRow()<2)return[];const vals=sh.getDataRange().getValues(),heads=vals[0];return vals.slice(1).map((r,i)=>{const o={_row:i+2};heads.forEach((h,j)=>{if(h)o[h]=r[j] instanceof Date?Utilities.formatDate(r[j],CFG.TZ,'yyyy-MM-dd'):r[j]});return o})}
function append_(name,row){db_().getSheetByName(name).appendRow(row)}
function write_(name,row,obj){const sh=db_().getSheetByName(name),heads=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0];heads.forEach((h,i)=>{if(Object.prototype.hasOwnProperty.call(obj,h))sh.getRange(row,i+1).setValue(obj[h])})}
function publicAppt_(a){return {id:a.id,name:a.name,service:a.service,date:a.date,time:a.time,therapist:a.therapist,status:a.status,changeCount:Number(a.changeCount)}}
function digits_(v){return String(v==null?'':v).replace(/\D/g,'')}
function clean_(v,n){let s=String(v==null?'':v).trim().slice(0,n);return /^[=+\-@]/.test(s)?"'"+s:s}
function random_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'')}
function hash_(v,s){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s)+'|'+String(v),Utilities.Charset.UTF_8))}
function constantEqual_(a,b){a=String(a);b=String(b);if(a.length!==b.length)return false;let x=0;for(let i=0;i<a.length;i++)x|=a.charCodeAt(i)^b.charCodeAt(i);return x===0}
function truth_(v){return v===true||String(v).toUpperCase()==='TRUE'}
function audit_(actor,role,action,id,detail){try{append_('AuditLog',[new Date(),actor,role,action,id,clean_(detail,300)])}catch(e){console.error(e)}}
function out_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON)}
